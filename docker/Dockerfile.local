# Local CPU build for llama-swap
#
# Build from local source on top of llama.cpp CPU server image.
#
# Usage:
#   docker build -f docker/Dockerfile.local -t llama-swap:local .

FROM ghcr.io/ggml-org/llama.cpp:server AS runtime

COPY --from=golang:1.24-alpine /usr/local/go /usr/local/go

ENV PATH="/usr/local/go/bin:${PATH}"
ENV CGO_ENABLED=0

WORKDIR /build
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN go build -o /app/llama-swap .

WORKDIR /models
